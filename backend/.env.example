# ===== DJANGO CORE SETTINGS =====
SECRET_KEY=generate-a-secure-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== DATABASE CONFIGURATION =====
# SQLite for local dev: DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL for production: DATABASE_URL=postgres://user:pass@host:5432/db_name
DATABASE_URL=

# ===== REDIS CONFIGURATION =====
REDIS_URL=redis://localhost:6379/0

# ===== EMAIL CONFIGURATION (Gmail SMTP for magic links) =====
# Use a Gmail App Password (NOT your real password):
#   1. Enable 2FA on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate an App Password for "Mail"
#   4. Paste the 16-character password below (no spaces)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
DEFAULT_FROM_EMAIL=Mr.Wam <your-gmail@gmail.com>
ADMIN_NOTIFICATION_EMAILS=admin@yourapp.com

# ===== MAGIC LINK SETTINGS =====
# Frontend URL where magic link verifies (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Email of the first admin (run: python manage.py create_initial_admin)
DJANGO_ADMIN_EMAIL=admin@mrwam.com

# ===== CORS SETTINGS =====
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===== JWT SETTINGS =====
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# ===== FILE UPLOAD SETTINGS =====
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,image/jpeg,image/png,image/jpg,text/csv,application/vnd.ms-excel

# ===== LOGGING =====
DJANGO_LOG_LEVEL=INFO
